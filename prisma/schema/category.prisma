

model Category {
    id            String    @id @default(uuid(7))
    name          String
    slug          String    @unique
    description   String?
    isDeleted     Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    products      Product[]

    @@index([name])
    @@index([isDeleted])
    @@map("categories")
}