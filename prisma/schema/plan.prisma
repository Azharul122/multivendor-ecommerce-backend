model Plan {
  id          String         @id @default(uuid(7))
  name        String
  price       Float
  interval        BillingInterval
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  subscriptions Subscription[]

  @@index([isDeleted])
  @@map("plans")
}

