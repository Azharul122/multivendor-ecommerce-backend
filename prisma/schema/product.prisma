

model Product {
    id            String @unique @id @default(uuid(7))
    name          String
    slug          String    @unique
    description   String?
    price         Float
    stock         Int @default(0)
    images        String[]
    isFeatured    Boolean   @default(false)
    isVerified    Boolean   @default(false)
    
    isDeleted     Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    sellerId String
    seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
    orders   Order[] @relation("OrderProducts")
    reports  Report[]
    blogs    Blog[] 
    categories Category[] 
    reviews  Review[]

    @@index([name])
    @@index([isDeleted])
    @@map("products")
}