

model Subscription {
    id            String    @id @default(uuid(7))
    userId        String
    plan          String
    status        String
    startDate     DateTime
    endDate       DateTime
    isDeleted     Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([isDeleted])
    @@map("subscriptions")
}